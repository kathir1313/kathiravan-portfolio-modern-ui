# EmailJS configuration for the Contact form.
# Get these values from https://www.emailjs.com after creating a service + template.
# If left unset, the contact form will show a graceful fallback message
# instead of crashing, and won't attempt to send an email.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
